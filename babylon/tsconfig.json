{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../src/**/*.ts", "../tools/bsp2glb.ts", "../tools/bsp2glb.d.ts"],
  "exclude": ["node_modules", "dist", "../src/mod/weapons.ts", "../src/mod/scoring.ts", "../src/mod/slowmo.ts", "../src/mod/slowmo-point.ts", "../src/mod/interface.ts", "../tools/decompile/cross-vendor", "../tools/decompile/output", "../tools/decompile/chunks"]
}
