*.local

# Game asset symlinks (live in _runtime_assets/, not in repo)
# The Babylon viewer's symlinks went with the viewer; the frontend's
# assets are served from R2 (see docs/ASSET-DELIVERY.md).

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo
Thumbs.db

# Smoke artifacts
test-output/
playwright-report/
playwright/.cache/
coverage/

# ─────────────────────────────────────────────────────────────
# Game assets — DO NOT COMMIT. The repo is asset-free.
# Users source HL1 + TS mod files separately.
# ─────────────────────────────────────────────────────────────
*.pak
*.bsp
*.mdl
*.wav
*.spr
*.txt   # catch-all for game-text files (motd, titles, etc.)
valve/
specialists/
cstrike/
tfc/
agility/
dod/
gearbox/
ricochet/
valve_hd/

# CheerpX binaries (downloaded at install time)
cheerpx/
*.so
*.so.*
*.dll
*.dylib

# T3 / agent worktrees
.t3-worktrees/
.worktrees/
.worktrees.md

# Logs
*.log
logs/

# Misc
.cache/
tmp/
# Runtime working files (HL1, TS mod, smoke zips, etc.)
# The repo is asset-free; these stay local but never commit.
_runtime_assets/

# Python cache (decompile pipeline uses Python)
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Old CheerpX bridge binary experiments (from Phase 1 v5/v6)
tools/ts-host*
tools/docker-test/

# Per-process AI logs (large, ephemeral)
progress/codex-*.log
progress/review-*.log
progress/grind.pid

# Module-level __pycache__
**/__pycache__/

# Exception to the blanket *.wasm rule above: the known-good TS server
# rollback baseline MUST be tracked. Without it a fresh clone has no way
# back from a bad deploy, and /tmp does not survive a reboot.
# (The many experimental shim builds under shim/build/ stay ignored on
# purpose — they are artifacts, not state.)
!tools/port/ts-server-dll/baseline/*.wasm

# A capture-script artifact: the frame after the spawn attempt. It is
# written with a neutral name on purpose -- the script cannot know
# whether it got a first-person view or the TS main menu, and a file
# named first-person.png holding the menu is a lie.
docs/screenshots/after-spawn.png
