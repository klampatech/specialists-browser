# ts-bridge — WebSocket↔UDP bridge for the browser client.
#
# The production host has no Node installed, and installing one on a box
# that only runs containers is a second thing to keep patched. So the
# bridge ships as an image like everything else.
#
#   docker build -f tools/deploy/Dockerfile.bridge -t ts-bridge:0.1 .
#   docker run -d --name bridge --network host \
#     -e BRIDGE_TARGETS=ts-0=127.0.0.1:27015 \
#     ts-bridge:0.1
#
# --network host so the bridge can reach the game servers on 127.0.0.1 and
# so Caddy can reach it on a loopback port. Nothing else needs to reach it:
# Caddy is the only client.

FROM node:22-bookworm-slim

WORKDIR /app

# `ws` is the only dependency. It is installed before the source is copied
# so the layer caches across source changes.
COPY tools/deploy/bridge/package.json /app/package.json
RUN npm install --omit=dev && npm cache clean --force

COPY tools/port/tsp-rs/scripts/ts-udp-bridge.js /app/bridge.js

# The target allowlist is the security boundary — without it this process
# would be an open UDP relay — so it comes from the environment, never from
# a file baked into the image.
# The registry maps the public address the browser knows to the internal
# target the packet goes to, so a newly started instance is reachable
# without restarting the bridge.
#
# BRIDGE_ALLOWED_PORTS is the SECURITY FLOOR: the only ports the bridge
# may ever dial, regardless of what the registry says. It is a range
# covering every instance the fleet can have, so it never has to be
# widened to add a server.
ENV BRIDGE_LISTEN=27017 \
    BRIDGE_HEALTH=/health \
    BRIDGE_REGISTRY_URL=http://127.0.0.1:8081/api/registry \
    BRIDGE_ALLOWED_HOST=127.0.0.1 \
    BRIDGE_ALLOWED_PORTS=27015-27022 \
    BRIDGE_TARGETS=default=127.0.0.1:27015@40.160.225.81:27015

EXPOSE 27017

# Non-root. The bridge needs no privileges at all: it opens a normal TCP
# listener and UDP client sockets.
RUN useradd --create-home --uid 10003 --shell /usr/sbin/nologin bridge \
 && chown -R bridge:bridge /app
USER bridge

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.BRIDGE_LISTEN||27017)+(process.env.BRIDGE_HEALTH||'/health')).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "/app/bridge.js"]
