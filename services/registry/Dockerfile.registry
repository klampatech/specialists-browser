# registry — the fleet's source of truth.
#
#   docker build -f services/registry/Dockerfile.registry -t registry:0.1 .
#   docker run -d --name registry --network host \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -e TS_PUBLIC=40.160.225.81 \
#     registry:0.1
#
# The docker socket is mounted because the tickrate and the bot quota live
# in the engine's console, and the only way to reach a running game's
# console is through its container. That is root-equivalent on the host.
#
# It is acceptable here because the host is a dedicated game box and the
# `ubuntu` user was already placed in the `docker` group during the
# initial hardening — the same privilege. The registry's own code is the
# only thing that holds this access.

FROM node:22-bookworm-slim

WORKDIR /app

COPY services/registry/package.json /app/package.json
COPY services/registry/service.mjs /app/services/registry/service.mjs
# The bot policy and the human-source decision live in a separate module
# so they can be unit-tested. Both were wrong at some point and both
# bugs were invisible from the outside.
COPY services/registry/lib/fleet-logic.mjs /app/services/registry/lib/fleet-logic.mjs
COPY services/registry/lib/a2s-retry.mjs /app/services/registry/lib/a2s-retry.mjs
COPY services/registry/lib/liveness.mjs /app/services/registry/lib/liveness.mjs

# The registry imports queryServer() from the Vite plugin rather than
# reimplementing A2S: the GoldSrc handshake rules are easy to get subtly
# wrong and impossible to notice until a server browser silently shows the
# wrong map. The plugin also carries the bots field, which is how the
# registry tells a human from a bot.
COPY webxash/vite-a2s-plugin.mjs /app/webxash/vite-a2s-plugin.mjs

# The docker CLI. The registry talks to the engine through the socket, and
# `docker logs` handles the multiplexed stream framing that the raw Engine
# API does not. The STATIC binary is used rather than the apt package
# because the apt package drags in the daemon.
#
# The socket is root:docker 0660, so the container also has to be started
# with the docker group added:
#   --group-add "$(getent group docker | cut -d: -f3)"
ARG DOCKER_CLI_VERSION=27.3.1
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) dcli=x86_64 ;; arm64) dcli=aarch64 ;; *) echo "unsupported arch: $arch" >&2; exit 1 ;; esac; \
    curl -fsSL "https://download.docker.com/linux/static/stable/$dcli/docker-$DOCKER_CLI_VERSION.tgz" \
      -o /tmp/docker.tgz; \
    tar -xzf /tmp/docker.tgz -C /tmp; \
    install -m 0755 "/tmp/docker/docker" /usr/local/bin/docker; \
    rm -rf /tmp/docker /tmp/docker.tgz; \
    apt-get purge -y curl; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*; \
    docker --version

ENV REGISTRY_BIND=127.0.0.1:8081 \
    TS_INSTANCE_COUNT=8 \
    TS_PORT_BASE=27015 \
    TS_CONTAINER_PREFIX=ts \
    TS_CONSOLE_PIPE=/tmp/console.pipe \
    REGISTRY_POLL_MS=10000 \
    REGISTRY_METRICS_MS=15000 \
    REGISTRY_FAILURES_BEFORE_DOWN=3 \
    BRIDGE_URL=http://127.0.0.1:27017/health \
    TS_TARGET_TICKRATE=100 \
    TS_DEGRADE_RATIO=0.85 \
    TS_RECOVER_RATIO=0.95 \
    TS_DEGRADE_SUSTAIN_MS=30000 \
    TS_ACTION_COOLDOWN_MS=120000 \
    TS_BOT_TARGET=4

EXPOSE 8081

RUN useradd --create-home --uid 10004 --shell /usr/sbin/nologin registry \
 && chown -R registry:registry /app
USER registry

CMD ["node", "/app/services/registry/service.mjs"]
